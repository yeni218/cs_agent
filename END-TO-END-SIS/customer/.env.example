# Point the app at your Supabase project (Settings -> API).
# When both are set, the login screen defaults to "supabase" live mode.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: fall back to the Node backend instead of Supabase
EXPO_PUBLIC_BACKEND_URL=http://localhost:8787
