# Copy to .env (backend reads process.env; use your shell or a loader).
# Data source: demo (default) | vapi (live proxy to api.vapi.ai)
DATA_SOURCE=demo

# Vapi PRIVATE API key — required when DATA_SOURCE=vapi. NEVER commit.
VAPI_API_KEY=

# Optional overrides
# VAPI_BASE_URL=https://api.vapi.ai
# ADMIN_KEY=some-secret        # if set, /admin/* requires Authorization: Bearer
PORT=8787
