# Copy to `.env` and fill in. `lk agent deploy` uploads these as encrypted
# secrets — LiveKit Cloud injects them into the container at runtime, so no key
# in this file ever ends up in the image or in git.

# --- LiveKit Cloud (Build plan: free, no credit card) — Settings -> Keys ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Our own engine keys ---
# NORMALLY LEAVE BLANK. The agent fetches these from Supabase at startup via
# the `agent-config` function, so they are stored and rotated in one place.
# Fill them in only for local `npm run console` runs, or as a break-glass
# fallback if Supabase is unreachable.
GROQ_API_KEY=
INWORLD_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
INWORLD_TTS_MODEL=inworld-tts-1.5-max
INWORLD_VOICE=Ashley
# Speech-to-text provider. 'inworld' streams over a WebSocket and is the
# low-latency choice; 'groq' is batch Whisper — cheaper, but adds dead air
# while it transcribes the whole utterance. Flip this to A/B on real calls.
STT_PROVIDER=inworld

# --- Supabase: where each finished call is recorded ---
# The agent POSTs to the `ingest-call` Edge Function, which owns cost
# computation and the audit chain. No service-role key lives in the agent.
SUPABASE_URL=https://tdmfpiynrybrnehnoaot.supabase.co
AFIYET_INGEST_SECRET=

# --- Which restaurant a call belongs to ---
# Used when the dialed number is unknown or unmapped.
AFIYET_ASSISTANT_ID=asst_lezzet
# Dialed number -> assistant. Normally comes from the Supabase `phone_numbers`
# table; this is only the fallback when Supabase is unreachable.
AFIYET_NUMBER_MAP={"+902127061540":"asst_lezzet"}
