# LiveKit Cloud (free tier, no credit card) — Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Your own engine keys (same values already in Supabase secrets)
GROQ_API_KEY=
INWORLD_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Supabase — to log each call (service role, server-side only)
SUPABASE_URL=https://tdmfpiynrybrnehnoaot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Which tenant/assistant these calls belong to
AFIYET_TENANT_ID=t_lezzet
AFIYET_ASSISTANT_ID=asst_lezzet
