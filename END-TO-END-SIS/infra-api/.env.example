# Afiyet Infra API config. Runs with mock providers if keys are absent.
PORT=8790
# Require Bearer auth (optional). Clients send Authorization: Bearer <API_KEY>
API_KEY=

# --- Groq (LLM + STT) ---
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Inworld (TTS) ---
INWORLD_API_KEY=            # Basic auth credential from Inworld
# INWORLD_TTS_URL=https://api.inworld.ai/tts/v1/voice
# Cheapest tested route:
# INWORLD_TTS_MODEL=inworld-tts-1.5-mini
# Quality/language fallback:
# INWORLD_TTS_MODEL=inworld-tts-2
# INWORLD_TTS_AUDIO_ENCODING=MP3
# INWORLD_TTS_SAMPLE_RATE=48000
# INWORLD_TTS_LANGUAGE=tr-TR

# --- Pricing (fills costBreakdown; tune to your real contracts) ---
# Cheap route defaults:
# - Groq Whisper Large v3 Turbo: $0.04/hr
# - Groq llama-3.1-8b-instant: $0.05/$0.08 per 1M tokens
# - Inworld TTS 1.5 Mini Builder: $9 per 1M chars
# - Verimor 10k package: 2,999 TL / 10,000 min
#
# Set USD_TRY and the Verimor package values to your current invoice before
# selling fixed-price plans. Explicit PRICE_* values always override package math.
USD_TRY=47.52
VERIMOR_PACKAGE_MINUTES=10000
VERIMOR_PACKAGE_PRICE_TRY=2999
VERIMOR_OVERAGE_TRY_PER_MIN=0.99
VERIMOR_BILLING_INCREMENT_SEC=6
# PRICE_STT_PER_SEC=0.0000111
# PRICE_LLM_IN_PER_1K=0.00005
# PRICE_LLM_OUT_PER_1K=0.00008
# PRICE_TTS_PER_1K_CHARS=0.009
# PRICE_TRANSPORT_PER_SEC=0.00010518
# PRICE_MEDIA_PER_SEC=0
# PRICE_PLATFORM_PER_CALL=0.005
# PRICE_PLATFORM_PER_SEC=0
# PRICE_TARGET_PER_MIN=0.02
