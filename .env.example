# Shared
NODE_ENV=development
PUBLIC_URL=https://your-public-url.ngrok-free.dev

# Agent domain:  insurance (default) | restaurant
AGENT_DOMAIN=insurance

# Insurance backend (PoliServis/PoliCore) data source:  mock (default) | live
POLISERVIS_MODE=mock
POLISERVIS_API_BASE_URL=http://localhost:5000
POLISERVIS_AGENT_TOKEN=
POLISERVIS_ACENTE_ID=
POLISERVIS_KAYNAK_ID=

# API app
API_PORT=8080
DATA_DIR=./data
DASHBOARD_API_TOKEN=

# Order store backend:  file (default) | postgres
# postgres requires DATABASE_URL and the "pg" package (npm install pg).
# Falls back to the file store if postgres is selected without DATABASE_URL.
ORDER_STORE=file
DATABASE_URL=
ORDER_STORE_TABLE=orders
DATABASE_SSL=false

# Voice agent app
VOICE_PORT=8081
ORDER_API_BASE_URL=http://localhost:8080
ORDER_API_TOKEN=

# AI providers
GROQ_API_KEY=gsk_your_groq_key
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

TTS_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GOOGLE_TTS_LANGUAGE_CODE=tr-TR
# Voice quality, low -> high:  Standard < Wavenet < Neural2 < Chirp3-HD
# Standard-A is robotic. Recommended: tr-TR-Wavenet-E (warm) or, for the most
# natural result, tr-TR-Chirp3-HD-* (pitch is ignored for Chirp voices).
GOOGLE_TTS_VOICE_NAME=tr-TR-Wavenet-E
GOOGLE_TTS_AUDIO_ENCODING=MULAW
GOOGLE_TTS_SAMPLE_RATE=8000
GOOGLE_TTS_SPEAKING_RATE=1
GOOGLE_TTS_PITCH=0

# Optional fallback if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_turkish_voice_id

# Turn detection backend:  energy (default) | silero
TURN_DETECTOR=energy
# Silero requires: npm install onnxruntime-node, and a v5 16kHz model file
SILERO_VAD_MODEL_PATH=
# Phone agent: adaptive noise floor (true by default) + semantic endpoint wait
VOICE_AGENT_ADAPTIVE_VAD=true
VOICE_AGENT_ENDPOINT_WAIT_MS=1000

# Realtime turn handling
BROWSER_AGENT_VAD_THRESHOLD=650
BROWSER_AGENT_SPEECH_FRAMES=2
BROWSER_AGENT_SILENCE_FRAMES=22
BROWSER_AGENT_MIN_SPEECH_BYTES=5600
BROWSER_AGENT_FALSE_INTERRUPTION_MS=1800
VOICE_AGENT_SPEECH_FRAMES=2
VOICE_AGENT_SILENCE_FRAMES=25
VOICE_AGENT_MIN_SPEECH_BYTES=4800

# Compliance (KVKK/SEDDK)
# Immutable hash-chained audit log of every turn/tool call/handoff. PII is
# redacted before write. Point at WORM/append-only storage in production.
AUDIT_LOG_PATH=./data/audit-log.jsonl

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
HUMAN_HANDOFF_NUMBER=+905551234567
