#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [ -f ".env" ]; then
  set -a
  # shellcheck disable=SC1091
  . ".env"
  set +a
else
  echo "No .env found. Starting with local defaults."
  echo "Copy .env.example to .env when you are ready to add Groq, ElevenLabs, and Twilio keys."
fi

API_PORT="${API_PORT:-8080}"
VOICE_PORT="${VOICE_PORT:-8081}"
export API_PORT
export VOICE_PORT
export ORDER_API_BASE_URL="${ORDER_API_BASE_URL:-http://localhost:${API_PORT}}"

if [ ! -d "node_modules" ] && [ ! -d "../node_modules" ]; then
  echo "Installing dependencies..."
  npm install
fi

if command -v lsof >/dev/null 2>&1; then
  if lsof -nP -iTCP:"${API_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port ${API_PORT} is already in use. Stop that server or run with API_PORT=another_port ./run"
    exit 1
  fi
  if lsof -nP -iTCP:"${VOICE_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port ${VOICE_PORT} is already in use. Stop that server or run with VOICE_PORT=another_port ./run"
    exit 1
  fi
fi

pids=()

cleanup() {
  echo
  echo "Stopping Afiyet AI..."
  for pid in "${pids[@]:-}"; do
    kill "$pid" >/dev/null 2>&1 || true
  done
}

trap cleanup INT TERM EXIT

echo "Starting Afiyet API on http://localhost:${API_PORT}"
npm run start:api &
pids+=("$!")

sleep 1

echo "Starting Afiyet voice agent on http://localhost:${VOICE_PORT}"
npm run start:voice &
pids+=("$!")

DASHBOARD_URL="http://localhost:${API_PORT}"
if [ "${DASHBOARD_API_TOKEN:-}" = "change-me-before-production" ]; then
  DASHBOARD_API_TOKEN=""
fi

if [ -n "${DASHBOARD_API_TOKEN:-}" ]; then
  DASHBOARD_URL="${DASHBOARD_URL}?token=${DASHBOARD_API_TOKEN}"
fi

cat <<EOF

Afiyet AI is starting.

Dashboard:   ${DASHBOARD_URL}
API health:  http://localhost:${API_PORT}/health
Voice health: http://localhost:${VOICE_PORT}/health

Press Ctrl+C to stop everything.
EOF

wait
